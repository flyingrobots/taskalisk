{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flyingrobots.dev/taskalisk/schemas/taskalisk.edge_edit/1.0.0",
  "title": "Taskalisk edge edit",
  "description": "The result of edit: which .blocked_by line was changed, whether it changed, and whether it was restored. The first result of an edit run.",
  "type": "object",
  "required": [
    "event",
    "t",
    "seq",
    "run",
    "type",
    "parent",
    "child",
    "changed",
    "reason",
    "recorded_in",
    "_schema"
  ],
  "properties": {
    "event": {
      "const": "edge_edit"
    },
    "t": {
      "type": "integer",
      "minimum": 0,
      "description": "POSIX time in milliseconds (Parley spec 1.3)."
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "The run's single counter (Parley spec 1.3)."
    },
    "run": {
      "type": "string",
      "minLength": 1,
      "description": "The execution this line belongs to (Parley spec 2.1)."
    },
    "type": {
      "enum": [
        "add_blocked_by",
        "remove_blocked_by"
      ]
    },
    "parent": {
      "type": "string",
      "minLength": 1
    },
    "child": {
      "type": "string",
      "minLength": 1
    },
    "changed": {
      "type": "boolean",
      "description": "Whether the child's body changed (or, in a dry run, would change)."
    },
    "reason": {
      "type": "string"
    },
    "recorded_in": {
      "type": "string",
      "minLength": 1
    },
    "dry_run": {
      "type": "boolean",
      "description": "Present and true in a --dry-run: nothing was written and nothing was recompiled."
    },
    "rolled_back": {
      "type": "boolean",
      "description": "Present when an added edge was undone because the run failed after the write: true when the old body was restored."
    },
    "rollback_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "error"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      }
    },
    "_schema": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "taskalisk.edge_edit"
        },
        "version": {
          "const": "1.0.0",
          "description": "Full validation is against the schema for this exact id and version (Parley spec 4.5)."
        }
      }
    }
  }
}
