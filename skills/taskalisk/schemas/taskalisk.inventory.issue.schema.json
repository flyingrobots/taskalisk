{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flyingrobots.dev/taskalisk/schemas/taskalisk.inventory.issue/1.0.0",
  "title": "Taskalisk open issue",
  "description": "One open issue of the home repository. Title is display text from GitHub, not checked by the trust gate in this mode.",
  "type": "object",
  "required": [
    "event",
    "t",
    "seq",
    "run",
    "number",
    "title",
    "milestone",
    "labels",
    "url",
    "_schema"
  ],
  "properties": {
    "event": {
      "const": "inventory.issue"
    },
    "t": {
      "type": "integer",
      "minimum": 0,
      "description": "POSIX time in milliseconds (Parley spec 1.3)."
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "The run's single counter (Parley spec 1.3)."
    },
    "run": {
      "type": "string",
      "minLength": 1,
      "description": "The execution this line belongs to (Parley spec 2.1)."
    },
    "number": {
      "type": "integer"
    },
    "title": {
      "type": "string"
    },
    "milestone": {
      "type": [
        "string",
        "null"
      ]
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "_schema": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "taskalisk.inventory.issue"
        },
        "version": {
          "const": "1.0.0",
          "description": "Full validation is against the schema for this exact id and version (Parley spec 4.5)."
        }
      }
    }
  }
}
